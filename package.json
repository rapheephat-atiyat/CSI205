{
  "name": "tuatua",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:db": "ts-node -r tsconfig-paths/register --project tsconfig.typeorm.json server/database/tests/memberships.test.ts",
    "test:db:integration": "ts-node -r tsconfig-paths/register --project tsconfig.typeorm.json server/database/tests/user-role-permissions.integration.test.ts",
    "typeorm": "ts-node -r tsconfig-paths/register --project tsconfig.typeorm.json ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d server/database/data-source.cli.ts",
    "migration:run": "npm run typeorm -- migration:run -d server/database/data-source.cli.ts",
    "migration:show": "npm run typeorm -- migration:show -d server/database/data-source.cli.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d server/database/data-source.cli.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "reflect-metadata": "^0.2.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^1.1.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261019.1": true
  }
}
